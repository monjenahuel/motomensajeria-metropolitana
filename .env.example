# Base del negocio
DB_USER=motomensajeria
DB_PASSWORD=motomensajeria123
DB_NAME=motomensajeria

# Base de Keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=keycloak123
KC_DB_NAME=keycloak

# Admin de Keycloak
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin123
KC_REALM=motomensajeria

# Tracking MS
TRACKING_PORT=3002
TRACKING_POS_TTL_S=30 # Segundos de expiracion

# RabbitMQ
EXCHANGE_NAME=motomensajeria.events
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
TRACKING_RABBITMQ_QUEUE=tracking.envios

#APIGATEWAY
APIGATEWAY_URL=http://localhost:3000

# Frontend del Cadete
CADETE_FRONT_PORT=5174
CADETE_FRONT_KEYCLOAK_CLIENT_ID=motomensajeria-web

# Frontend del Operador
OPERADOR_FRONT_PORT=5173
OPERADOR_FRONT_TRACKING_URL=http://localhost:3002
OPERADOR_FRONT_KEYCLOAK_CLIENT_ID=motomensajeria-web